# Windows .bat fayllari CRLF talab qiladi — LF bilan buziladi
# (echo. -> "cho." xatosi). Git checkout qanday sozlangan bo'lishidan
# qat'i nazar kafolatlaymiz.
*.bat text eol=crlf
*.cmd text eol=crlf

# Qolgan matn fayllar repoda LF
*.py text eol=lf
*.md text eol=lf
*.html text eol=lf

# Linux skriptlari HAR DOIM LF bo'lishi shart. CRLF bo'lsa bash uni
# umuman ishga tushira olmaydi ("bad interpreter: /usr/bin/env bash^M").
# Bu .bat dagi teskari muammoning aynan aksi.
*.sh text eol=lf
