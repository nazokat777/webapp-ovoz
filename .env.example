# ── MAJBURIY ──────────────────────────────────────────────────────────────
# BotFather'dan olingan token. Kodga YOZMANG — faqat shu yerda / Railway Variables'da.
BOT_TOKEN=
# OpenAI kaliti — STT, tozalash, tarjima va TTS uchun. Busiz bot ishlamaydi.
OPENAI_API_KEY=

# ── ADMIN ─────────────────────────────────────────────────────────────────
# Admin Telegram user ID (raqam). Username'dan ko'ra ishonchli — buni to'ldiring.
# Bir nechta admin bo'lsa vergul bilan: 123,456
ADMIN_USER_ID=
# Foydalanuvchilarga ko'rsatiladigan aloqa (ixtiyoriy)
ADMIN_CONTACT=@Nazokat_571
SUPPORT_NAME=Audio Bot Yordam markazi

# ── TO'LOV ────────────────────────────────────────────────────────────────
PAYMENT_CARD=
PAYMENT_CARD_HOLDER=
# Telegram Payments (ixtiyoriy — BotFather → Payments)
PAYMENT_PROVIDER_TOKEN=
PAYMENT_CURRENCY=UZS

# ── STT ───────────────────────────────────────────────────────────────────
# Muxlisa AI (o'zbek native STT). Bo'sh bo'lsa hamma narsa OpenAI orqali ketadi.
MUXLISA_KEY=

# ── WEBAPP / SERVER ───────────────────────────────────────────────────────
# Railway o'zi RAILWAY_PUBLIC_DOMAIN beradi — u holda buni to'ldirish shart emas.
WEBAPP_URL=
# PORT'ni Railway/Fly o'zi beradi; lokal sinov uchun HTTP_PORT.
HTTP_PORT=8000
# Railway volume mount qilingan bo'lsa: /data/user_data.json
DATA_FILE=

# ── YUKLAMA VA NAVBAT (ixtiyoriy) ─────────────────────────────────────────
# Maksimal yuklama hajmi, MB
MAX_UPLOAD_MB=300
# Bir vaqtda nechta og'ir ish (STT/tarjima/TTS) bajariladi.
# Serverga RAM/CPU qo'shsangiz oshiring.
MAX_CONCURRENT_JOBS=3
# Navbatda kutishi mumkin bo'lgan ishlar soni (oshsa foydalanuvchi rad etiladi)
MAX_QUEUED_JOBS=12
# Bepul tarifni ham Muxlisa'ga yo'naltirish (qimmat!). Default: o'chiq.
# MUXLISA_FOR_FREE=1
# WebApp initData imzosi necha soat amal qiladi (replay himoyasi).
# Katta qiymat = uzoq mikrofon sessiyalari qulay, kichik = xavfsizroq.
INIT_DATA_MAX_AGE_HOURS=6

# ── YOUTUBE (ixtiyoriy) ───────────────────────────────────────────────────
# Netscape formatdagi cookies matni yoki fayl yo'li
YOUTUBE_COOKIES=
YOUTUBE_COOKIES_FILE=
